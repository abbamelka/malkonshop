# =============================================
# SERVER CONFIGURATION
# =============================================
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000/api
CLIENT_URL=http://localhost:3000

# =============================================
# DATABASE CONFIGURATION (MySQL)
# =============================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db
DB_PORT=3306

# =============================================
# JWT CONFIGURATION
# =============================================
JWT_SECRET=Melkamu19
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=Melkamu@19
JWT_REFRESH_EXPIRE=90d

# =============================================
# PAYMENT GATEWAY (Stripe)
# =============================================
STRIPE_SECRET_KEY=Melkamu19
STRIPE_PUBLISHABLE_KEY=Melkamu19
STRIPE_WEBHOOK_SECRET=Melkamu19

# =============================================
# FILE UPLOAD & CLOUD STORAGE (Cloudinary)
# =============================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AWS S3 Configuration (Alternative to Cloudinary)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name

# =============================================
# EMAIL SERVICE (Nodemailer)
# =============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Email Templates
EMAIL_FROM=noreply@yourecommerce.com
EMAIL_FROM_NAME=Your E-Commerce Store

# =============================================
# CACHE & SESSION (Redis)
# =============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://localhost:6379

# =============================================
# EXTERNAL APIs
# =============================================
# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Facebook OAuth (Optional)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Shipping API (Optional)
SHIPPING_API_KEY=your_shipping_api_key
SHIPPING_API_URL=https://api.shippingprovider.com

# =============================================
# SECURITY & RATE LIMITING
# =============================================
API_KEY=your_internal_api_key_for_microservices
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# =============================================
# LOGGING
# =============================================
LOG_LEVEL=info
LOG_FILE=logs/combined.log
ERROR_LOG_FILE=logs/error.log

# =============================================
# APPLICATION SPECIFIC
# =============================================
APP_NAME=E-Commerce Store
SUPPORT_EMAIL=support@yourecommerce.com
SUPPORT_PHONE=+1-555-0123

# Default admin user (for first time setup)
DEFAULT_ADMIN_EMAIL=admin@yourecommerce.com
DEFAULT_ADMIN_PASSWORD=admin123

# File upload limits
MAX_FILE_SIZE=5242880
MAX_FILES=5

# Session configuration
SESSION_SECRET=your_session_secret_key
SESSION_MAX_AGE=86400000

# CORS origins (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourapp.vercel.app